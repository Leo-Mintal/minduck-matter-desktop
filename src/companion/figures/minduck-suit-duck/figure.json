  },
  "author": "Minduck",
  "entry": "figure.js",
  "export": "createSuitDuckBody",
  "thumb": "artwork.svg",
  "axes": [],
  "presets": [],
  "vocab": [
    {
      "id": "neutral",
      "kind": "expression",
      "names": {
        "zh": [
          "平静"
        ]
      },
      "about": {
        "zh": "保留发光白眼，轻轻呼吸",
        "en": "Keeps its glowing white eyes and breathes softly"
      },
      "seconds": 0.9
    },
    {
      "id": "happy",
      "kind": "expression",
      "names": {
        "zh": [
          "开心"
        ]
      },
      "about": {
        "zh": "发光眼睛眯起，身体轻轻弹动",
