      "about": {
        "zh": "轻轻蹦一下",
        "en": "Makes a small hop"
      },
      "seconds": 0.9
    },
    {
      "id": "turn",
      "kind": "motion",
      "names": {
        "zh": [
          "转身"
        ]
      },
      "about": {
        "zh": "水平转向另一侧",
