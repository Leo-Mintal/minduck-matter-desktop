      "seconds": 5.85
    },
    {
      "id": "ask",
      "kind": "motion",
      "names": {
        "zh": [
          "询问",
          "请求确认"
        ],
        "en": [
          "confirm"
        ]
      },
      "about": {
        "zh": "播放完整的待机到询问动作流：掏出纸笔，显示勾号与问号，随后收好纸笔并恢复待机。",
        "en": "Plays the complete idle-to-question flow, takes out paper and pen, shows check and question badges, then puts them away and returns to idle."
      },
      "seconds": 6
    }
  ],
  "sounds": {},
  "can": {
    "walk": true
  }
}
