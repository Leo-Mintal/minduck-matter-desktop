      "seconds": 0.4
    },
    {
      "id": "wave",
      "kind": "motion",
      "names": {
        "zh": [
          "招手",
          "打招呼"
        ]
      },
      "about": {
        "zh": "抬起近侧翅膀挥动",
        "en": "Raises and waves its near wing"
      },
      "seconds": 1.7
    },
    {
      "id": "flap",
      "kind": "motion",
      "names": {
        "zh": [
          "扑腾",
          "扑翅膀"
        ]
