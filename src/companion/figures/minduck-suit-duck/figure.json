    {
      "id": "jump",
      "kind": "motion",
      "names": {
        "zh": [
          "跳",
          "跳起来"
        ]
      },
      "about": {
        "zh": "下蹲后起跳，张开翅膀，落地回弹",
        "en": "Crouches, jumps with wings spread, and rebounds on landing"
